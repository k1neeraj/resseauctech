# Gmail SMTP credentials used by /api/contact.
# Use a Gmail App Password for the account in SMTP_USER; never commit real credentials.
SMTP_USER=
SMTP_PASS=

# Where genuine enquiries should be delivered.
CONTACT_TO=info@resseauxtech.com
CONTACT_BCC=
SPAM_BCC=

# Optional sender label/address. Keep the sender address authorised for SMTP_USER.
FROM_EMAIL=

# Optional Google Search Console URL-prefix verification token.
# Paste only the token shown by Search Console, not the full HTML meta tag.
# Domain-property verification is normally done with a DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=
